# Last updated 02/11/2026
# Global look-and-feel only: applies to every fzf call (Ctrl-R, Alt-C, cdi...).
# File-specific preview/actions live in FZF_CTRL_T_OPTS in .zshrc.


# Use 80% of terminal height
--height=80%

# Reverse layout puts the prompt at the top
--layout=reverse

# Add a border around the UI
--border

# Show checkmark when selecting multiple items
--marker='✓ '

# Custom color scheme
--color=fg+:yellow,header:italic:underline

# Bindings
--bind='tab:toggle+down'
